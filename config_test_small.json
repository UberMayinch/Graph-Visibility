{
  "general": {
    "random_seed": 42,
    "precision_degree": 6,
    "num_params": 3,
    "stabilizing_time": 100,
    "window_size": 50
  },
  "fhn": {
    "enabled": true,
    "initial_conditions": {
      "u_count": 1,
      "v_count": 1,
      "u_base": 1.0,
      "u_range": 0.1,
      "v_base": 1.0,
      "v_range": 0.1
    },
    "parameters": {
      "A_min": 0.1,
      "A_max": 0.3,
      "column_u": "u",
      "column_v": "v"
    },
    "analysis": {
      "process_timeseries": false,
      "bifurcation_diagram": false,
      "construct_graphs": true,
      "weighted_degree_summary": true,
      "unweighted_degree_summary": true
    }
  },
  "linard": {
    "enabled": false,
    "initial_conditions": {
      "x_count": 1,
      "y_count": 1,
      "x_base": 1.0,
      "x_range": 0.1,
      "y_base": 1.0,
      "y_range": 0.1
    },
    "parameters": {
      "omega_min": 0.8,
      "omega_max": 1.2,
      "column_x": "x",
      "column_y": "y"
    },
    "analysis": {
      "process_timeseries": false,
      "bifurcation_diagram": false,
      "construct_graphs": true,
      "weighted_degree_summary": true,
      "unweighted_degree_summary": true
    }
  },
  "simulation": {
    "fhn_num_steps": 5000,
    "linard_num_steps": 3000
  },
  "execution_mode": {
    "calculate_advanced_metrics": true
  },
  "output_files": {
    "weighted_degree_stats": "weighted_degree_stats.csv",
    "unweighted_degree_stats": "unweighted_degree_stats.csv"
  },
  "plot_options": {
    "enabled_metrics": ["avg_degree", "max_degree", "degree_entropy"],
    "figure_size": [8, 4.5],
    "dpi": 150,
    "show_plots": false,
    "save_plots": true,
    "colors": {
      "individual_lines": "#6c757d",
      "mean": "#1f77b4",
      "envelope_4sigma": "#2ca02c",
      "envelope_6sigma": "#ff7f0e"
    },
    "alpha_individual": 0.35,
    "alpha_envelope_4sigma": 0.20,
    "alpha_envelope_6sigma": 0.10
  }
}
